{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["yteraoka"],
  "extends": [
    "config:base"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Automerge minor and below; major updates stay manual",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    }
  ]
}
